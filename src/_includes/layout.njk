<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ title or site.tagline }} | {{ site.personName }} · {{ site.siteName }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ site.domain }}{{ page.url }}">
    <meta property="og:title" content="{{ title or site.tagline }} | {{ site.personName }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.domain }}{{ page.url }}">
    <meta name="twitter:card" content="summary">
    <meta id="theme-color-light" name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)">
    <meta id="theme-color-dark" name="theme-color" content="#141518" media="(prefers-color-scheme: dark)">
    <meta name="color-scheme" content="light dark">
    <script>{% include "theme.js" %}</script>
    {% if page.url == "/404.html" %}<meta name="robots" content="noindex">{% endif %}
    <link rel="stylesheet" href="/assets/css/site.css">
    <script src="/assets/js/header.js" defer></script>
    {% if page.url == "/" %}<script src="/assets/js/field-note.js" defer></script>{% endif %}
    <link rel="manifest" href="/site.webmanifest">
    {% if page.url == "/" %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": {{ site.personName | dump | safe }},
        "url": {{ (site.domain + '/') | dump | safe }},
        "email": {{ ('mailto:' + site.email) | dump | safe }},
        "description": {{ site.description | dump | safe }}
      }
    </script>
    {% endif %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner site-shell">
        <div class="site-identity">
          <a class="brand" href="/" aria-label="Jane Swift — home">
            <span class="brand-name">{{ site.personName }}</span>
          </a>
          <div class="brand-details">
            <span class="brand-domain">{{ site.siteName }}</span>
            <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch theme" hidden>
              <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
              </svg>
              <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" />
              </svg>
            </button>
          </div>
        </div>
        <nav class="site-nav" aria-label="Primary">
          {% for item in site.nav %}
          <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {% endfor %}
        </nav>
      </div>
    </header>
    <main id="main" class="site-shell" tabindex="-1">
      {{ content | safe }}
    </main>
    <footer class="site-footer site-shell">
      <div><a class="footer-name" href="/">{{ site.personName }}</a><p>{{ site.tagline }}</p></div>
      <div><a href="mailto:{{ site.email }}">{{ site.email }}</a><p>{{ site.location }} <span aria-hidden="true">·</span> {{ site.siteName }}</p></div>
    </footer>
  </body>
</html>
